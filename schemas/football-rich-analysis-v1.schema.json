{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazaku22.github.io/Football-rich-new/schemas/football-rich-analysis-v1.schema.json",
  "title": "Football rich Analysis Import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "report_id",
    "created_at",
    "analysis_as_of",
    "match",
    "market",
    "analysis",
    "recommendation",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_type": {
      "const": "football-rich-analysis"
    },
    "report_id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_as_of": {
      "type": "string",
      "format": "date-time"
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "competition",
        "home_team",
        "away_team",
        "kickoff_at",
        "timezone"
      ],
      "properties": {
        "competition": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "home_team": {
          "type": "string",
          "minLength": 1
        },
        "away_team": {
          "type": "string",
          "minLength": 1
        },
        "home_team_crest_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "away_team_crest_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "home_table_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "away_table_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "kickoff_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        },
        "match_status": {
          "enum": [
            "scheduled",
            "live",
            "finished",
            "unknown"
          ]
        },
        "match_id_external": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_type",
        "selected_team",
        "handicap_line",
        "decimal_odds",
        "odds_checked_at"
      ],
      "properties": {
        "market_type": {
          "const": "asian_handicap"
        },
        "selected_team": {
          "enum": [
            "home",
            "away",
            "none"
          ]
        },
        "handicap_line": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -4,
          "maximum": 4,
          "description": "Handicap applied to selected_team; negative means giving a handicap, positive means receiving one. Null only when selected_team is none and no verified line exists."
        },
        "decimal_odds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 1
        },
        "odds_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "bookmaker_or_source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "favorite_side",
        "form_summary",
        "home_away_summary",
        "team_news_summary",
        "match_outcome_probabilities",
        "handicap_settlement_probabilities",
        "cover_probability",
        "probability_status",
        "risk_level",
        "reasoning",
        "limitations"
      ],
      "properties": {
        "favorite_side": {
          "enum": [
            "home",
            "away",
            "none"
          ]
        },
        "form_summary": {
          "type": "string"
        },
        "home_away_summary": {
          "type": "string"
        },
        "team_news_summary": {
          "type": "string"
        },
        "match_outcome_probabilities": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "home_win",
            "draw",
            "away_win"
          ],
          "properties": {
            "home_win": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "draw": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "away_win": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "handicap_settlement_probabilities": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "full_win",
            "half_win",
            "push",
            "half_loss",
            "full_loss"
          ],
          "properties": {
            "full_win": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "half_win": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "push": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "half_loss": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "full_loss": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "cover_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "probability_status": {
          "enum": [
            "estimated",
            "insufficient_data"
          ]
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high",
            "undetermined"
          ]
        },
        "reasoning": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_goals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "home",
            "away"
          ],
          "properties": {
            "home": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "away": {
              "type": "number",
              "minimum": 0,
              "maximum": 8
            },
            "basis": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Expected goals estimated from verified pre-match evidence; used by the app's Independent Poisson calculator when outcome probabilities are omitted."
        },
        "risk_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Risk score 0-100; higher means more uncertainty/risk. Weighted score from risk_components."
        },
        "data_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Evidence/data confidence score, separate from outcome probability and risk score."
        },
        "risk_components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data_completeness",
            "form_instability",
            "factor_disagreement",
            "lineup_uncertainty",
            "market_volatility"
          ],
          "properties": {
            "data_completeness": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "form_instability": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "factor_disagreement": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "lineup_uncertainty": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "market_volatility": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "description": "Each component is a risk score from 0-100; weighted 30/25/20/15/10 respectively."
        },
        "factor_assessments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recent_form_5": {
              "type": [
                "string",
                "null"
              ]
            },
            "head_to_head": {
              "type": [
                "string",
                "null"
              ]
            },
            "key_players": {
              "type": [
                "string",
                "null"
              ]
            },
            "injuries_suspensions": {
              "type": [
                "string",
                "null"
              ]
            },
            "home_away_form": {
              "type": [
                "string",
                "null"
              ]
            },
            "scoring_conceding_rates": {
              "type": [
                "string",
                "null"
              ]
            },
            "opponent_strength": {
              "type": [
                "string",
                "null"
              ]
            },
            "schedule_motivation_tactics": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "model_calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "settled_sample_size",
            "brier_score_1x2",
            "brier_score_ah"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_calibrated",
                "monitoring",
                "evaluated"
              ]
            },
            "settled_sample_size": {
              "type": "integer",
              "minimum": 0
            },
            "brier_score_1x2": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            },
            "brier_score_ah": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 2
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "candidate_handicaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selected_team",
              "handicap_line",
              "handicap_settlement_probabilities",
              "cover_probability",
              "risk_score"
            ],
            "properties": {
              "selected_team": {
                "enum": [
                  "home",
                  "away"
                ]
              },
              "handicap_line": {
                "type": "number",
                "minimum": -4,
                "maximum": 4
              },
              "handicap_settlement_probabilities": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "full_win",
                  "half_win",
                  "push",
                  "half_loss",
                  "full_loss"
                ],
                "properties": {
                  "full_win": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "half_win": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "push": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "half_loss": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "full_loss": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "cover_probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "risk_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "decimal_odds": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 1
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "odds_checked_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_team",
        "handicap_line",
        "cover_probability",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "recommended",
            "provisional",
            "pass",
            "no_recommendation"
          ]
        },
        "selected_team": {
          "enum": [
            "home",
            "away",
            "none"
          ]
        },
        "handicap_line": {
          "type": [
            "number",
            "null"
          ]
        },
        "cover_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string"
        },
        "stake_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publisher",
          "url",
          "checked_at",
          "claim"
        ],
        "properties": {
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "claim": {
            "type": "string"
          },
          "reliability_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
